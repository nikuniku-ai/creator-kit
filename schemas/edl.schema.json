{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/nikuniku-ai/creator-kit/schemas/edl.schema.json",
 "title": "S10 edl.json — adopted takes in order",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "schema_version",
  "plan_sha256",
  "total_ms",
  "entries"
 ],
 "properties": {
  "schema_version": {
   "const": 1
  },
  "plan_sha256": {
   "$ref": "#/$defs/sha256"
  },
  "total_ms": {
   "type": "integer",
   "minimum": 0
  },
  "entries": {
   "type": "array",
   "minItems": 1,
   "maxItems": 500,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "shot_id",
     "job_id",
     "file",
     "sha256",
     "in_ms",
     "out_ms",
     "record_in_ms"
    ],
    "properties": {
     "shot_id": {
      "$ref": "#/$defs/id"
     },
     "job_id": {
      "$ref": "#/$defs/id"
     },
     "file": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
     },
     "sha256": {
      "$ref": "#/$defs/sha256"
     },
     "in_ms": {
      "type": "integer",
      "minimum": 0
     },
     "out_ms": {
      "type": "integer",
      "minimum": 1
     },
     "record_in_ms": {
      "type": "integer",
      "minimum": 0
     }
    }
   }
  }
 },
 "$defs": {
  "id": {
   "type": "string",
   "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
  },
  "sha256": {
   "type": "string",
   "pattern": "^[a-f0-9]{64}$"
  },
  "lang": {
   "enum": [
    "en",
    "zh-Hant",
    "zh-Hans",
    "ja",
    "ko",
    "vi",
    "id",
    "th",
    "es",
    "pt-BR",
    "fr",
    "de",
    "ar",
    "hi"
   ]
  }
 }
}
